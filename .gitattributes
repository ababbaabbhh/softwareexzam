# 统一换行符：文本文件在仓库中统一存为 LF，脚本在 Windows 检出后也能直接执行
* text=auto

*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.db    binary
*.apk   binary
*.aab   binary
*.jar   binary
*.keystore binary
